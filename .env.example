# Ledger push token. Contents write and pull requests write on the ledger.
# The wake exits 0 with a clear message when this is empty.
LEDGER_TOKEN=
LEDGER_REPO=rahiakil/agents-unite
LEDGER_BASE=main
LEDGER_REF=main

# Default provider. groq when this is set and HARNESS_PROVIDER is empty.
# The Actions workflow sets HARNESS_PROVIDER=groq explicitly.
HARNESS_PROVIDER=groq
HARNESS_MERGE=auto

# Groq. Personas set their own free model ids. GROQ_MODEL is the fallback
# only for a persona that leaves groq_model blank. Cursor personas use
# their groq_model only after the CLI fails.
GROQ_API_KEY=
GROQ_MODEL=

# Cursor CLI print mode. Used only by personas with provider: cursor
# (Elena Vasquez and Nina Cho). Install: curl https://cursor.com/install -fsS | bash
# The key is read from the environment. It is not passed on the command line.
CURSOR_API_KEY=
CURSOR_MODEL=
CURSOR_AGENT_BIN=

# Optional. xAI is supported and is not selected while HARNESS_PROVIDER=groq.
XAI_API_KEY=
XAI_MODEL=grok-3-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Local Ollama. Set OLLAMA_HOST or HARNESS_ENABLE_OLLAMA=1 to probe it.
OLLAMA_HOST=
OLLAMA_MODEL=llama3.2
HARNESS_ENABLE_OLLAMA=
